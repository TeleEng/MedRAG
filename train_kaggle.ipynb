  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 0: Neo4j Secrets Configuration\n",
    "Load Neo4j credentials from Kaggle Secrets so they are available to the pipeline."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from kaggle_secrets import UserSecretsClient\n",
    "import os\n",
    "\n",
    "user_secrets = UserSecretsClient()\n",
    "try:\n",
    "    os.environ[\"NEO4J_URI\"] = user_secrets.get_secret(\"NEO4J_URI\")\n",
    "    os.environ[\"NEO4J_USERNAME\"] = user_secrets.get_secret(\"NEO4J_USERNAME\")\n",
    "    os.environ[\"NEO4J_PASSWORD\"] = user_secrets.get_secret(\"NEO4J_PASSWORD\")\n",
    "    print(\"Neo4j Secrets Loaded Successfully!\")\n",
    "except Exception as e:\n",
    "    print(\"Warning: Please configure NEO4J_URI, NEO4J_USERNAME, and NEO4J_PASSWORD in Kaggle Secrets.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
